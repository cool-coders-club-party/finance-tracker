FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY . .
ARG SERVICE=market-data-service
RUN sh ./mvnw -B -pl "services/$SERVICE" -am -Dmaven.test.skip=true package \
    && cp "services/$SERVICE/target/$SERVICE-"*.jar /tmp/service.jar

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /tmp/service.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]


